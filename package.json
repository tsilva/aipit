{
  "name": "llm-pit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "python3 scripts/infisical/run.py dev",
    "dev:secrets": "python3 scripts/infisical/run.py dev",
    "secrets:check": "python3 scripts/infisical/run.py check",
    "secrets:add": "python3 scripts/infisical/add_secret.py",
    "build:secrets": "python3 scripts/infisical/run.py build",
    "start:secrets": "python3 scripts/infisical/run.py start",
    "build": "node scripts/generate-avatar-asset-versions.mjs && next build",
    "start": "node scripts/dev-server.mjs next start",
    "lint": "eslint",
    "check:dependencies": "node scripts/check-dependency-sources.mjs && npm audit --audit-level=high",
    "sentry:issues": "node scripts/sentry-issues.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/verify-provider-routing.mjs && vitest run",
    "test:e2e": "playwright test",
    "dev:bitwarden": "node scripts/bitwarden-run.mjs dev",
    "build:bitwarden": "node scripts/bitwarden-run.mjs build",
    "start:bitwarden": "node scripts/bitwarden-run.mjs start",
    "bitwarden:check": "node scripts/bitwarden-run.mjs check",
    "bitwarden:add": "uv run --locked --project scripts/bitwarden python scripts/bitwarden/add_secret.py",
    "test:provider": "node scripts/verify-provider-routing.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "10.75.2",
    "@vercel/analytics": "^1.6.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "eslint-plugin-react-hooks": {
      "zod": "4.6.6",
      ".": "7.1.1"
    },
    "source-map-js": "1.2.2",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.15"
    },
    "fast-uri": "3.1.9",
    "zod@>=4 <4.6.6": "4.6.6",
    "vite": "8.3.3"
  }
}
