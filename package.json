{
  "name": "llm-pit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "node scripts/dev-server.mjs next dev",
    "build": "node scripts/generate-avatar-asset-versions.mjs && next build",
    "start": "node scripts/dev-server.mjs next start",
    "lint": "eslint",
    "check:dependencies": "node scripts/check-dependency-sources.mjs && npm audit --audit-level=high",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/verify-provider-routing.mjs && vitest run",
    "test:e2e": "playwright test",
    "test:provider": "node scripts/verify-provider-routing.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "10.75.2",
    "@vercel/analytics": "^1.6.1",
    "lucide-react": "^1.60.0",
    "next": "16.4.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.5.31",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "eslint-plugin-react-hooks": {
      ".": "7.0.1",
      "zod": "4.6.6"
    },
    "source-map-js": "1.2.2",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.15"
    },
    "fast-uri": "3.1.9",
    "vite": "8.3.3",
    "zod@>=4 <4.6.6": "4.6.6",
    "glob@>=9 <14.0.2": "14.0.2",
    "minimatch@>=7 <11.0.1": "11.0.1"
  }
}
